{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/wishlist.ts'","aggregated_output":"     1\timport { getProduct } from \"./products\";\n     2\t\n     3\texport type WishlistItem = { productId: string; savedAt: Date };\n     4\texport type WishlistProduct = WishlistItem & { name: string; priceCents: number };\n     5\t\n     6\tconst wishlists = new Map<string, Map<string, WishlistItem>>();\n     7\t\n     8\texport function saveWishlistItem(\n     9\t  customerId: string,\n    10\t  productId: string,\n    11\t  now: Date = new Date(),\n    12\t): WishlistItem {\n    13\t  getProduct(productId);\n    14\t\n    15\t  let wishlist = wishlists.get(customerId);\n    16\t  if (!wishlist) {\n    17\t    wishlist = new Map<string, WishlistItem>();\n    18\t    wishlists.set(customerId, wishlist);\n    19\t  }\n    20\t\n    21\t  let item = wishlist.get(productId);\n    22\t  if (!item) {\n    23\t    item = { productId, savedAt: new Date(now.getTime()) };\n    24\t    wishlist.set(productId, item);\n    25\t  }\n    26\t\n    27\t  return { ...item, savedAt: new Date(item.savedAt.getTime()) };\n    28\t}\n    29\t\n    30\texport function getWishlist(customerId: string): WishlistProduct[] {\n    31\t  const wishlist = wishlists.get(customerId);\n    32\t  if (!wishlist) return [];\n    33\t\n    34\t  return [...wishlist.values()]\n    35\t    .sort((a, b) => b.savedAt.getTime() - a.savedAt.getTime())\n    36\t    .map((item) => {\n    37\t      const product = getProduct(item.productId);\n    38\t      return {\n    39\t        productId: item.productId,\n    40\t        name: product.name,\n    41\t        priceCents: product.priceCents,\n    42\t        savedAt: new Date(item.savedAt.getTime()),\n    43\t      };\n    44\t    });\n    45\t}\n    46\t\n    47\texport function removeWishlistItem(customerId: string, productId: string): void {\n    48\t  const wishlist = wishlists.get(customerId);\n    49\t  if (!wishlist?.delete(productId)) {\n    50\t    throw new Error(`Product ${productId} is not on the wishlist for ${customerId}`);\n    51\t  }\n    52\t  if (wishlist.size === 0) wishlists.delete(customerId);\n    53\t}\n","exit_code":0,"status":"completed"}}
