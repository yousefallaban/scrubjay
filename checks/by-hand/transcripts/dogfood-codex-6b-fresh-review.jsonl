{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc 'nl -ba test/wishlist.test.ts'","aggregated_output":"     1\timport { describe, expect, spyOn, test } from \"bun:test\";\n     2\timport * as webshop from \"../src/index\";\n     3\timport * as products from \"../src/products\";\n     4\timport { getWishlist, removeWishlistItem, saveWishlistItem } from \"../src/wishlist\";\n     5\t\n     6\tdescribe(\"wishlist\", () => {\n     7\t  test(\"saves only a product ID and save time [wishlist/save-items#product-only-items]\", () => {\n     8\t    const savedAt = new Date(\"2026-10-13T10:00:00Z\");\n     9\t\n    10\t    expect(saveWishlistItem(\"product-only\", \"headlamp\", savedAt)).toEqual({\n    11\t      productId: \"headlamp\",\n    12\t      savedAt,\n    13\t    });\n    14\t  });\n    15\t\n    16\t  test(\"defaults the save moment to the current time [wishlist/save-items#product-only-items]\", () => {\n    17\t    const before = Date.now();\n    18\t    const item = saveWishlistItem(\"default-time\", \"wool-socks\");\n    19\t\n    20\t    expect(item.productId).toBe(\"wool-socks\");\n    21\t    expect(item.savedAt.getTime()).toBeGreaterThanOrEqual(before);\n    22\t    expect(item.savedAt.getTime()).toBeLessThanOrEqual(Date.now());\n    23\t  });\n    24\t\n    25\t  test(\"rejects a product absent from the catalogue [wishlist/save-items#reject-unknown-product]\", () => {\n    26\t    expect(() => saveWishlistItem(\"unknown-product\", \"unicorn\")).toThrow(Error);\n    27\t    expect(getWishlist(\"unknown-product\")).toEqual([]);\n    28\t  });\n    29\t\n    30\t  test(\"retains saves for every catalogue product [wishlist/save-items#save-item]\", () => {\n    31\t    const savedAt = new Date(\"2026-10-13T10:00:00Z\");\n    32\t\n    33\t    for (const product of products.listProducts()) {\n    34\t      const customerId = `save-${product.id}`;\n    35\t      saveWishlistItem(customerId, product.id, savedAt);\n    36\t\n    37\t      expect(getWishlist(customerId)).toEqual([\n    38\t        { productId: product.id, name: product.name, priceCents: product.priceCents, savedAt },\n    39\t      ]);\n    40\t    }\n    41\t  });\n    42\t\n    43\t  test(\"uses one wishlist for each supplied customer ID [wishlist/save-items#customer-id-wishlist]\", () => {\n    44\t    saveWishlistItem(\"no-customer-record\", \"headlamp\", new Date(\"2026-10-13T10:00:00Z\"));\n    45\t    saveWishlistItem(\"no-customer-record\", \"trail-map\", new Date(\"2026-10-13T10:05:00Z\"));\n    46\t\n    47\t    expect(getWishlist(\"no-customer-record\").map((item) => item.productId)).toEqual([\n    48\t      \"trail-map\",\n    49\t      \"headlamp\",\n    50\t    ]);\n    51\t  });\n    52\t\n    53\t  test(\"preserves the first save and position on a duplicate [wishlist/save-items#preserve-first-save]\", () => {\n    54\t    const firstSave = new Date(\"2026-10-13T10:00:00Z\");\n    55\t    const secondSave = new Date(\"2026-10-13T10:05:00Z\");\n    56\t    saveWishlistItem(\"duplicate\", \"headlamp\", firstSave);\n    57\t    saveWishlistItem(\"duplicate\", \"trail-map\", secondSave);\n    58\t\n    59\t    expect(saveWishlistItem(\"duplicate\", \"headlamp\", new Date(\"2026-10-13T10:10:00Z\"))).toEqual({\n    60\t      productId: \"headlamp\",\n    61\t      savedAt: firstSave,\n    62\t    });\n    63\t    expect(getWishlist(\"duplicate\").map(({ productId, savedAt }) => ({ productId, savedAt }))).toEqual([\n    64\t      { productId: \"trail-map\", savedAt: secondSave },\n    65\t      { productId: \"headlamp\", savedAt: firstSave },\n    66\t    ]);\n    67\t  });\n    68\t\n    69\t  test(\"protects the first save from caller mutations [wishlist/save-items#preserve-first-save]\", () => {\n    70\t    const originalTime = new Date(\"2026-10-13T10:00:00Z\");\n    71\t    const inputTime = new Date(originalTime.getTime());\n    72\t    const saved = saveWishlistItem(\"copies\", \"headlamp\", inputTime);\n    73\t    inputTime.setTime(0);\n    74\t    saved.savedAt.setTime(1);\n    75\t    saved.productId = \"trail-map\";\n    76\t\n    77\t    const repeated = saveWishlistItem(\"copies\", \"headlamp\", new Date(\"2026-10-13T11:00:00Z\"));\n    78\t    expect(repeated).toEqual({ productId: \"headlamp\", savedAt: originalTime });\n    79\t    repeated.savedAt.setTime(2);\n    80\t    repeated.productId = \"wool-socks\";\n    81\t\n    82\t    const viewed = getWishlist(\"copies\");\n    83\t    expect(viewed).toEqual([\n    84\t      { productId: \"headlamp\", name: \"Headlamp\", priceCents: 3499, savedAt: originalTime },\n    85\t    ]);\n    86\t    viewed[0].savedAt.setTime(3);\n    87\t    viewed[0].productId = \"water-bottle\";\n    88\t    viewed[0].name = \"Changed\";\n    89\t    viewed[0].priceCents = 0;\n    90\t    viewed.pop();\n    91\t\n    92\t    expect(getWishlist(\"copies\")).toEqual([\n    93\t      { productId: \"headlamp\", name: \"Headlamp\", priceCents: 3499, savedAt: originalTime },\n    94\t    ]);\n    95\t  });\n    96\t\n    97\t  test(\"reads only the addressed customer's products [wishlist/view-items#isolate-wishlists]\", () => {\n    98\t    saveWishlistItem(\"reader-one\", \"headlamp\");\n    99\t    saveWishlistItem(\"reader-two\", \"trail-map\");\n   100\t\n   101\t    expect(getWishlist(\"reader-one\").map((item) => item.productId)).toEqual([\"headlamp\"]);\n   102\t    expect(getWishlist(\"reader-two\").map((item) => item.productId)).toEqual([\"trail-map\"]);\n   103\t  });\n   104\t\n   105\t  test(\"uses customer IDs as supplied [wishlist/save-items#customer-id-wishlist]\", () => {\n   106\t    saveWishlistItem(\"Exact-ID\", \"headlamp\");\n   107\t    saveWishlistItem(\"exact-id\", \"trail-map\");\n   108\t    saveWishlistItem(\" Exact-ID \", \"wool-socks\");\n   109\t    saveWishlistItem(\"\", \"water-bottle\");\n   110\t\n   111\t    expect(getWishlist(\"Exact-ID\").map((item) => item.productId)).toEqual([\"headlamp\"]);\n   112\t    expect(getWishlist(\"exact-id\").map((item) => item.productId)).toEqual([\"trail-map\"]);\n   113\t    expect(getWishlist(\" Exact-ID \").map((item) => item.productId)).toEqual([\"wool-socks\"]);\n   114\t    expect(getWishlist(\"\").map((item) => item.productId)).toEqual([\"water-bottle\"]);\n   115\t  });\n   116\t\n   117\t  test(\"resolves current catalogue details on every read [wishlist/view-items#current-product-details]\", () => {\n   118\t    const getProduct = products.getProduct;\n   119\t    const currentProduct = { ...getProduct(\"headlamp\"), priceCents: 3000 };\n   120\t    const lookup = spyOn(products, \"getProduct\").mockImplementation((id) =>\n   121\t      id === currentProduct.id ? { ...currentProduct } : getProduct(id),\n   122\t    );\n   123\t\n   124\t    try {\n   125\t      const savedAt = new Date(\"2026-10-13T10:00:00Z\");\n   126\t      saveWishlistItem(\"current-details\", \"headlamp\", savedAt);\n   127\t      currentProduct.name = \"Updated headlamp\";\n   128\t      currentProduct.priceCents = 3500;\n   129\t\n   130\t      expect(getWishlist(\"current-details\")).toEqual([\n   131\t        { productId: \"headlamp\", name: \"Updated headlamp\", priceCents: 3500, savedAt },\n   132\t      ]);\n   133\t\n   134\t      currentProduct.priceCents = 3600;\n   135\t      expect(getWishlist(\"current-details\")[0].priceCents).toBe(3600);\n   136\t    } finally {\n   137\t      lookup.mockRestore();\n   138\t    }\n   139\t  });\n   140\t\n   141\t  test(\"orders by save time rather than call order [wishlist/view-items#newest-first]\", () => {\n   142\t    saveWishlistItem(\"ordered\", \"headlamp\", new Date(\"2026-10-13T10:00:00Z\"));\n   143\t    saveWishlistItem(\"ordered\", \"trail-map\", new Date(\"2026-10-13T10:10:00Z\"));\n   144\t    saveWishlistItem(\"ordered\", \"wool-socks\", new Date(\"2026-10-13T10:05:00Z\"));\n   145\t\n   146\t    expect(getWishlist(\"ordered\").map((item) => item.productId)).toEqual([\n   147\t      \"trail-map\",\n   148\t      \"wool-socks\",\n   149\t      \"headlamp\",\n   150\t    ]);\n   151\t  });\n   152\t\n   153\t  test(\"keeps insertion order for equal save times [wishlist/view-items#newest-first]\", () => {\n   154\t    const savedAt = new Date(\"2026-10-13T10:00:00Z\");\n   155\t    saveWishlistItem(\"tied-times\", \"headlamp\", savedAt);\n   156\t    saveWishlistItem(\"tied-times\", \"trail-map\", savedAt);\n   157\t    saveWishlistItem(\"tied-times\", \"headlamp\", savedAt);\n   158\t\n   159\t    expect(getWishlist(\"tied-times\").map((item) => item.productId)).toEqual([\"headlamp\", \"trail-map\"]);\n   160\t  });\n   161\t\n   162\t  test(\"returns an empty list for a customer with no saves [wishlist/view-items#empty-list]\", () => {\n   163\t    expect(getWishlist(\"never-saved\")).toEqual([]);\n   164\t  });\n   165\t\n   166\t  test(\"removes the addressed product and leaves other saves [wishlist/remove-items#remove-item]\", () => {\n   167\t    saveWishlistItem(\"removal\", \"headlamp\");\n   168\t    saveWishlistItem(\"removal\", \"trail-map\");\n   169\t    const remaining = getWishlist(\"removal\").filter((item) => item.productId === \"trail-map\");\n   170\t\n   171\t    expect(removeWishlistItem(\"removal\", \"headlamp\")).toBeUndefined();\n   172\t    expect(getWishlist(\"removal\")).toEqual(remaining);\n   173\t\n   174\t    removeWishlistItem(\"removal\", \"trail-map\");\n   175\t    expect(getWishlist(\"removal\")).toEqual([]);\n   176\t  });\n   177\t\n   178\t  test(\"allows a removed product to be saved anew [wishlist/remove-items#remove-item]\", () => {\n   179\t    saveWishlistItem(\"save-again\", \"headlamp\", new Date(\"2026-10-13T10:00:00Z\"));\n   180\t    removeWishlistItem(\"save-again\", \"headlamp\");\n   181\t    const savedAt = new Date(\"2026-10-13T11:00:00Z\");\n   182\t\n   183\t    expect(saveWishlistItem(\"save-again\", \"headlamp\", savedAt)).toEqual({ productId: \"headlamp\", savedAt });\n   184\t    expect(getWishlist(\"save-again\")).toEqual([\n   185\t      { productId: \"headlamp\", name: \"Headlamp\", priceCents: 3499, savedAt },\n   186\t    ]);\n   187\t  });\n   188\t\n   189\t  test(\"rejects removal of an unsaved product without changing the list [wishlist/remove-items#reject-unsaved-product]\", () => {\n   190\t    saveWishlistItem(\"unsaved-removal\", \"trail-map\");\n   191\t    const before = getWishlist(\"unsaved-removal\");\n   192\t\n   193\t    expect(() => removeWishlistItem(\"unsaved-removal\", \"headlamp\")).toThrow(Error);\n   194\t    expect(() => removeWishlistItem(\"unsaved-removal\", \"unicorn\")).toThrow(Error);\n   195\t    expect(getWishlist(\"unsaved-removal\")).toEqual(before);\n   196\t  });\n   197\t\n   198\t  test(\"rejects removal from an absent or emptied wishlist [wishlist/remove-items#reject-unsaved-product]\", () => {\n   199\t    expect(() => removeWishlistItem(\"empty-removal\", \"headlamp\")).toThrow(Error);\n   200\t    expect(getWishlist(\"empty-removal\")).toEqual([]);\n   201\t\n   202\t    saveWishlistItem(\"empty-removal\", \"headlamp\");\n   203\t    removeWishlistItem(\"empty-removal\", \"headlamp\");\n   204\t\n   205\t    expect(() => removeWishlistItem(\"empty-removal\", \"headlamp\")).toThrow(Error);\n   206\t    expect(getWishlist(\"empty-removal\")).toEqual([]);\n   207\t  });\n   208\t\n   209\t  test(\"leaves other customers unchanged after successful or failed removal [wishlist/remove-items#isolate-removal]\", () => {\n   210\t    saveWishlistItem(\"removal-one\", \"headlamp\");\n   211\t    saveWishlistItem(\"removal-two\", \"headlamp\");\n   212\t    saveWishlistItem(\"removal-two\", \"trail-map\");\n   213\t    const otherWishlist = getWishlist(\"removal-two\");\n   214\t\n   215\t    expect(() => removeWishlistItem(\"removal-one\", \"trail-map\")).toThrow(Error);\n   216\t    expect(getWishlist(\"removal-two\")).toEqual(otherWishlist);\n   217\t\n   218\t    removeWishlistItem(\"removal-one\", \"headlamp\");\n   219\t    expect(getWishlist(\"removal-one\")).toEqual([]);\n   220\t    expect(getWishlist(\"removal-two\")).toEqual(otherWishlist);\n   221\t\n   222\t    expect(() => removeWishlistItem(\"removal-one\", \"headlamp\")).toThrow(Error);\n   223\t    expect(getWishlist(\"removal-two\")).toEqual(otherWishlist);\n   224\t  });\n   225\t\n   226\t  test(\"supports a full wishlist flow through the public entry point [wishlist/save-items#save-item]\", () => {\n   227\t    const savedAt = new Date(\"2026-10-13T10:00:00Z\");\n   228\t    const saved: webshop.WishlistItem = webshop.saveWishlistItem(\"public-exports\", \"headlamp\", savedAt);\n   229\t    expect(saved).toEqual({ productId: \"headlamp\", savedAt });\n   230\t\n   231\t    const wishlist: webshop.WishlistProduct[] = webshop.getWishlist(\"public-exports\");\n   232\t    expect(wishlist).toEqual([\n   233\t      { productId: \"headlamp\", name: \"Headlamp\", priceCents: 3499, savedAt },\n   234\t    ]);\n   235\t\n   236\t    expect(webshop.removeWishlistItem(\"public-exports\", \"headlamp\")).toBeUndefined();\n   237\t    expect(webshop.getWishlist(\"public-exports\")).toEqual([]);\n   238\t  });\n   239\t});\n","exit_code":0,"status":"completed"}}
