{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc 'rtk git diff --no-ext-diff main...HEAD -- src/ test/'","aggregated_output":"src/index.ts          |   1 +\n src/wishlist.ts       |  53 +++++++++++\n test/wishlist.test.ts | 239 ++++++++++++++++++++++++++++++++++++++++++++++++++\n 3 files changed, 293 insertions(+)\n\nChanges:\n\nsrc/index.ts\n@@ -1,3 +1,4 @@\n export * from \"./products\";\n export * from \"./orders\";\n export * from \"./returns\";\n+export * from \"./wishlist\";\n  +1 -0\n\nsrc/wishlist.ts\n@@ -0,0 +1,53 @@\n+import { getProduct } from \"./products\";\n+\n+export type WishlistItem = { productId: string; savedAt: Date };\n+export type WishlistProduct = WishlistItem & { name: string; priceCents: number };\n+\n+const wishlists = new Map<string, Map<string, WishlistItem>>();\n+\n+export function saveWishlistItem(\n+  customerId: string,\n+  productId: string,\n+  now: Date = new Date(),\n+): WishlistItem {\n+  getProduct(productId);\n+\n+  let wishlist = wishlists.get(customerId);\n+  if (!wishlist) {\n+    wishlist = new Map<string, WishlistItem>();\n+    wishlists.set(customerId, wishlist);\n+  }\n+\n+  let item = wishlist.get(productId);\n+  if (!item) {\n+    item = { productId, savedAt: new Date(now.getTime()) };\n+    wishlist.set(productId, item);\n+  }\n+\n+  return { ...item, savedAt: new Date(item.savedAt.getTime()) };\n+}\n+\n+export function getWishlist(customerId: string): WishlistProduct[] {\n+  const wishlist = wishlists.get(customerId);\n+  if (!wishlist) return [];\n+\n+  return [...wishlist.values()]\n+    .sort((a, b) => b.savedAt.getTime() - a.savedAt.getTime())\n+    .map((item) => {\n+      const product = getProduct(item.productId);\n+      return {\n+        productId: item.productId,\n+        name: product.name,\n+        priceCents: product.priceCents,\n+        savedAt: new Date(item.savedAt.getTime()),\n+      };\n+    });\n+}\n+\n+export function removeWishlistItem(customerId: string, productId: string): void {\n+  const wishlist = wishlists.get(customerId);\n+  if (!wishlist?.delete(productId)) {\n+    throw new Error(`Product ${productId} is not on the wishlist for ${customerId}`);\n+  }\n+  if (wishlist.size === 0) wishlists.delete(customerId);\n+}\n  +53 -0\n\ntest/wishlist.test.ts\n@@ -0,0 +1,239 @@\n+import { describe, expect, spyOn, test } from \"bun:test\";\n+import * as webshop from \"../src/index\";\n+import * as products from \"../src/products\";\n+import { getWishlist, removeWishlistItem, saveWishlistItem } from \"../src/wishlist\";\n+\n+describe(\"wishlist\", () => {\n+  test(\"saves only a product ID and save time [wishlist/save-items#product-only-items]\", () => {\n+    const savedAt = new Date(\"2026-10-13T10:00:00Z\");\n+\n+    expect(saveWishlistItem(\"product-only\", \"headlamp\", savedAt)).toEqual({\n+      productId: \"headlamp\",\n+      savedAt,\n+    });\n+  });\n+\n+  test(\"defaults the save moment to the current time [wishlist/save-items#product-only-items]\", () => {\n+    const before = Date.now();\n+    const item = saveWishlistItem(\"default-time\", \"wool-socks\");\n+\n+    expect(item.productId).toBe(\"wool-socks\");\n+    expect(item.savedAt.getTime()).toBeGreaterThanOrEqual(before);\n+    expect(item.savedAt.getTime()).toBeLessThanOrEqual(Date.now());\n+  });\n+\n+  test(\"rejects a product absent from the catalogue [wishlist/save-items#reject-unknown-product]\", () => {\n+    expect(() => saveWishlistItem(\"unknown-product\", \"unicorn\")).toThrow(Error);\n+    expect(getWishlist(\"unknown-product\")).toEqual([]);\n+  });\n+\n+  test(\"retains saves for every catalogue product [wishlist/save-items#save-item]\", () => {\n+    const savedAt = new Date(\"2026-10-13T10:00:00Z\");\n+\n+    for (const product of products.listProducts()) {\n+      const customerId = `save-${product.id}`;\n+      saveWishlistItem(customerId, product.id, savedAt);\n+\n+      expect(getWishlist(customerId)).toEqual([\n+        { productId: product.id, name: product.name, priceCents: product.priceCents, savedAt },\n+      ]);\n+    }\n+  });\n+\n+  test(\"uses one wishlist for each supplied customer ID [wishlist/save-items#customer-id-wishlist]\", () => {\n+    saveWishlistItem(\"no-customer-record\", \"headlamp\", new Date(\"2026-10-13T10:00:00Z\"));\n+    saveWishlistItem(\"no-customer-record\", \"trail-map\", new Date(\"2026-10-13T10:05:00Z\"));\n+\n+    expect(getWishlist(\"no-customer-record\").map((item) => item.productId)).toEqual([\n+      \"trail-map\",\n+      \"headlamp\",\n+    ]);\n+  });\n+\n+  test(\"preserves the first save and position on a duplicate [wishlist/save-items#preserve-first-save]\", () => {\n+    const firstSave = new Date(\"2026-10-13T10:00:00Z\");\n+    const secondSave = new Date(\"2026-10-13T10:05:00Z\");\n+    saveWishlistItem(\"duplicate\", \"headlamp\", firstSave);\n+    saveWishlistItem(\"duplicate\", \"trail-map\", secondSave);\n+\n+    expect(saveWishlistItem(\"duplicate\", \"headlamp\", new Date(\"2026-10-13T10:10:00Z\"))).toEqual({\n+      productId: \"headlamp\",\n+      savedAt: firstSave,\n+    });\n+    expect(getWishlist(\"duplicate\").map(({ productId, savedAt }) => ({ productId, savedAt }))).toEqual([\n+      { productId: \"trail-map\", savedAt: secondSave },\n+      { productId: \"headlamp\", savedAt: firstSave },\n+    ]);\n+  });\n+\n+  test(\"protects the first save from caller mutations [wishlist/save-items#preserve-first-save]\", () => {\n+    const originalTime = new Date(\"2026-10-13T10:00:00Z\");\n+    const inputTime = new Date(originalTime.getTime());\n+    const saved = saveWishlistItem(\"copies\", \"headlamp\", inputTime);\n+    inputTime.setTime(0);\n+    saved.savedAt.setTime(1);\n+    saved.productId = \"trail-map\";\n+\n+    const repeated = saveWishlistItem(\"copies\", \"headlamp\", new Date(\"2026-10-13T11:00:00Z\"));\n+    expect(repeated).toEqual({ productId: \"headlamp\", savedAt: originalTime });\n+    repeated.savedAt.setTime(2);\n+    repeated.productId = \"wool-socks\";\n+\n+    const viewed = getWishlist(\"copies\");\n+    expect(viewed).toEqual([\n+      { productId: \"headlamp\", name: \"Headlamp\", priceCents: 3499, savedAt: originalTime },\n+    ]);\n+    viewed[0].savedAt.setTime(3);\n+    viewed[0].productId = \"water-bottle\";\n+    viewed[0].name = \"Changed\";\n+    viewed[0].priceCents = 0;\n+    viewed.pop();\n+\n+    expect(getWishlist(\"copies\")).toEqual([\n+      { productId: \"headlamp\", name: \"Headlamp\", priceCents: 3499, savedAt: originalTime },\n+    ]);\n+  });\n+\n+  test(\"reads only the addressed customer's products [wishlist/view-items#isolate-wishlists]\", () => {\n+    saveWishlistItem(\"reader-one\", \"headlamp\");\n+    saveWishlistItem(\"reader-two\", \"trail-map\");\n+\n  ... (139 additions truncated)\n  +239 -0\n[full diff: rtk git diff --no-compact]\n","exit_code":0,"status":"completed"}}
