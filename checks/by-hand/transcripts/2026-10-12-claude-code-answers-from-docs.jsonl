Hint":"","aliases":["instinct-status"]},{"name":"everything-claude-code:kotlin-build","description":"(everything-claude-code) Fix Kotlin/Gradle build errors, compiler warnings, and dependency issues incrementally. Invokes the kotlin-build-resolver agent for minimal, surgical fixes.","argumentHint":""},{"name":"everything-claude-code:kotlin-review","description":"(everything-claude-code) Comprehensive Kotlin code review for idiomatic patterns, null safety, coroutine safety, and security. Invokes the kotlin-reviewer agent.","argumentHint":""},{"name":"everything-claude-code:kotlin-test","description":"(everything-claude-code) Enforce TDD workflow for Kotlin. Write Kotest tests first, then implement. Verify 80%+ coverage with Kover.","argumentHint":""},{"name":"everything-claude-code:learn-eval","description":"(everything-claude-code) Extract reusable patterns from the session, self-evaluate quality before saving, and determine the right save location (Global vs Project).","argumentHint":""},{"name":"everything-claude-code:learn","description":"(everything-claude-code) /learn - Extract Reusable Patterns","argumentHint":""},{"name":"everything-claude-code:loop-start","description":"(everything-claude-code) Loop Start Command","argumentHint":""},{"name":"everything-claude-code:loop-status","description":"(everything-claude-code) Loop Status Command","argumentHint":""},{"name":"everything-claude-code:model-route","description":"(everything-claude-code) Model Route Command","argumentHint":""},{"name":"everything-claude-code:multi-backend","description":"(everything-claude-code) Backend - Backend-Focused Development","argumentHint":""},{"name":"everything-claude-code:multi-execute","description":"(everything-claude-code) Execute - Multi-Model Collaborative Execution","argumentHint":""},{"name":"everything-claude-code:multi-frontend","description":"(everything-claude-code) Frontend - Frontend-Focused Development","argumentHint":""},{"name":"everything-claude-code:multi-plan","description":"(everything-claude-code) Plan - Multi-Model Collaborative Planning","argumentHint":""},{"name":"everything-claude-code:multi-workflow","description":"(everything-claude-code) Workflow - Multi-Model Collaborative Development","argumentHint":""},{"name":"everything-claude-code:orchestrate","description":"(everything-claude-code) Sequential and tmux/worktree orchestration guidance for multi-agent workflows.","argumentHint":""},{"name":"everything-claude-code:plan","description":"(everything-claude-code) Restate requirements, assess risks, and create step-by-step implementation plan. WAIT for user CONFIRM before touching any code.","argumentHint":""},{"name":"everything-claude-code:pm2","description":"(everything-claude-code) PM2 Init","argumentHint":""},{"name":"everything-claude-code:projects","description":"(everything-claude-code) List known projects and their instinct statistics","argumentHint":"","aliases":["projects"]},{"name":"everything-claude-code:promote","description":"(everything-claude-code) Promote project-scoped instincts to global scope","argumentHint":"","aliases":["promote"]},{"name":"everything-claude-code:prompt-optimize","description":"(everything-claude-code) Analyze a draft prompt and output an optimized, ECC-enriched version ready to paste and run. Does NOT execute the task — outputs advisory analysis only.","argumentHint":""},{"name":"everything-claude-code:prune","description":"(everything-claude-code) Delete pending instincts older than 30 days that were never promoted","argumentHint":"","aliases":["prune"]},{"name":"everything-claude-code:python-review","description":"(everything-claude-code) Comprehensive Python code review for PEP 8 compliance, type hints, security, and Pythonic idioms. Invokes the python-reviewer agent.","argumentHint":""},{"name":"everything-claude-code:quality-gate","description":"(everything-claude-code) Quality Gate Command","argumentHint":""},{"name":"everything-claude-code:refactor-clean","description":"(everything-claude-code) Refactor Clean","argumentHint":""},{"name":"everything-claude-code:resume-session","description":"(everything-claude-code) Load the most recent session file from ~/.claude/sessions/ and resume work with full context from where the last session ended.","argumentHint":""},{"name":"everything-claude-code:rules-distill","description":"(everything-claude-code) Scan skills to extract cross-cutting principles and distill them into rules","argumentHint":""},{"name":"everything-claude-code:rust-build","description":"(everything-claude-code) Fix Rust build errors, borrow checker issues, and dependency problems incrementally. Invokes the rust-build-resolver agent for minimal, surgical fixes.","argumentHint":""},{"name":"everything-claude-code:rust-review","description":"(everything-claude-code) Comprehensive Rust code review for ownership, lifetimes, error handling, unsafe usage, and idiomatic patterns. Invokes the rust-reviewer agent.","argumentHint":""},{"name":"everything-claude-code:rust-test","description":"(everything-claude-code) Enforce TDD workflow for Rust. Write tests first, then implement. Verify 80%+ coverage with cargo-llvm-cov.","argumentHint":""},{"name":"everything-claude-code:save-session","description":"(everything-claude-code) Save current session state to a dated file in ~/.claude/sessions/ so work can be resumed in a future session with full context.","argumentHint":""},{"name":"everything-claude-code:sessions","description":"(everything-claude-code) Manage Claude Code session history, aliases, and session metadata.","argumentHint":""},{"name":"everything-claude-code:setup-pm","description":"(everything-claude-code) Configure your preferred package manager (npm/pnpm/yarn/bun)","argumentHint":""},{"name":"everything-claude-code:skill-create","description":"(everything-claude-code) Analyze local git history to extract coding patterns and generate SKILL.md files. Local version of the Skill Creator GitHub App.","argumentHint":"","aliases":["skill-create"]},{"name":"everything-claude-code:skill-health","description":"(everything-claude-code) Show skill portfolio health dashboard with charts and analytics","argumentHint":"","aliases":["skill-health"]},{"name":"everything-claude-code:tdd","description":"(everything-claude-code) Enforce test-driven development workflow. Scaffold interfaces, generate tests FIRST, then implement minimal code to pass. Ensure 80%+ coverage.","argumentHint":""},{"name":"everything-claude-code:test-coverage","description":"(everything-claude-code) Test Coverage","argumentHint":""},{"name":"everything-claude-code:update-codemaps","description":"(everything-claude-code) Update Codemaps","argumentHint":""},{"name":"everything-claude-code:update-docs","description":"(everything-claude-code) Update Documentation","argumentHint":""},{"name":"everything-claude-code:verify","description":"(everything-claude-code) Verification Command","argumentHint":""},{"name":"feature-dev:feature-dev","description":"(feature-dev) Guided feature development with codebase understanding and architecture focus","argumentHint":"Optional feature description"},{"name":"pr-review-toolkit:review-pr","description":"(pr-review-toolkit) Comprehensive PR review using specialized agents","argumentHint":"[review-aspects]"},{"name":"stripe:explain-error","description":"(stripe) Explain Stripe error codes and provide solutions with code examples","argumentHint":"error_code or error_message"},{"name":"stripe:test-cards","description":"(stripe) Display Stripe test card numbers for various testing scenarios","argumentHint":"scenario"},{"name":"agent-skills:api-and-interface-design","description":"(agent-skills) Guides stable API and interface design. Use when designing APIs, module boundaries, or any public interface. Use when creating REST or GraphQL endpoints, defining type contracts between modules, or establishing boundaries between frontend and backend.","argumentHint":"","aliases":["api-and-interface-design"]},{"name":"agent-skills:browser-testing-with-devtools","description":"(agent-skills) Tests in real browsers via Chrome DevTools MCP. Use when building or debugging anything that runs in a browser. Use when you need to inspect the DOM, capture console errors, analyze network requests, profile performance, or verify visual output with real runtime data. Requires the chrome-devtools MCP server to be configured.","argumentHint":"","aliases":["browser-testing-with-devtools"]},{"name":"agent-skills:ci-cd-and-automation","description":"(agent-skills) Automates CI/CD pipeline setup. Use when setting up or modifying build and deployment pipelines. Use when you need to automate quality gates, configure test runners in CI, or establish deployment strategies.","argumentHint":"","aliases":["ci-cd-and-automation"]},{"name":"agent-skills:code-review-and-quality","description":"(agent-skills) Conducts multi-axis code review. Use before merging any change. Use when reviewing code written by yourself, another agent, or a human. Use when you need to assess code quality across multiple dimensions before it enters the main branch.","argumentHint":"","aliases":["code-review-and-quality"]},{"name":"agent-skills:code-simplification","description":"(agent-skills) Simplifies code for clarity. Use when refactoring code for clarity without changing behavior. Use when code works but is harder to read, maintain, or extend than it should be. Use when reviewing code that has accumulated unnecessary complexity.","argumentHint":"","aliases":["code-simplification"]},{"name":"agent-skills:context-engineering","description":"(agent-skills) Optimizes agent context setup. Use when starting a new session, when agent output quality degrades, when switching between tasks, or when you need to configure rules files and context for a project.","argumentHint":"","aliases":["context-engineering"]},{"name":"agent-skills:debugging-and-error-recovery","description":"(agent-skills) Guides systematic root-cause debugging. Use when tests fail, builds break, behavior doesn't match expectations, or you encounter any unexpected error. Use when you need a systematic approach to finding and fixing the root cause rather than guessing.","argumentHint":"","aliases":["debugging-and-error-recovery"]},{"name":"agent-skills:deprecation-and-migration","description":"(agent-skills) Manages deprecation and migration. Use when removing old systems, APIs, or features. Use when migrating users from one implementation to another. Use when deciding whether to maintain or sunset existing code.","argumentHint":"","aliases":["deprecation-and-migration"]},{"name":"agent-skills:documentation-and-adrs","description":"(agent-skills) Records decisions and documentation. Use when making architectural decisions, changing public APIs, shipping features, or when you need to record context that future engineers and agents will need to understand the codebase.","argumentHint":"","aliases":["documentation-and-adrs"]},{"name":"agent-skills:doubt-driven-development","description":"(agent-skills) Subjects every non-trivial decision to a fresh-context adversarial review before it stands. Use when correctness matters more than speed, when working in unfamiliar code, when stakes are high (production, security-sensitive logic, irreversible operations), or any time a confident output would be cheaper to verify now than to debug later.","argumentHint":"","aliases":["doubt-driven-development"]},{"name":"agent-skills:frontend-ui-engineering","description":"(agent-skills) Builds production-quality UIs. Use when building or modifying user-facing interfaces. Use when creating components, implementing layouts, managing state, or when the output needs to look and feel production-quality rather than AI-generated.","argumentHint":"","aliases":["frontend-ui-engineering"]},{"name":"agent-skills:git-workflow-and-versioning","description":"(agent-skills) Structures git workflow practices. Use when making any code change. Use when committing, branching, resolving conflicts, or when you need to organize work across multiple parallel streams.","argumentHint":"","aliases":["git-workflow-and-versioning"]},{"name":"agent-skills:idea-refine","description":"(agent-skills) Refines raw ideas into sharp, actionable concepts through structured divergent and convergent thinking. Use when an idea is still vague, when you need to stress-test assumptions before committing to a plan, or when you want to expand options before converging on one. Triggers on \"ideate\", \"refine this idea\", or \"stress-test my plan\".","argumentHint":"","aliases":["idea-refine"]},{"name":"agent-skills:incremental-implementation","description":"(agent-skills) Delivers changes incrementally. Use when implementing any feature or change that touches more than one file. Use when you're about to write a large amount of code at once, or when a task feels too big to land in one step.","argumentHint":"","aliases":["incremental-implementation"]},{"name":"agent-skills:interview-me","description":"(agent-skills) Extracts what the user actually wants instead of what they think they should want. Achieves this through one-question-at-a-time interview until ~95% confidence about the underlying intent. Use when an ask is underspecified (\"build me X\" without \"for whom\" or \"why now\"), when the user explicitly invokes (\"interview me\", \"grill me\", \"are we sure?\", \"stress-test my thinking\"), or when you catch yourself silently filling in ambiguous requirements before any plan, spec, or code exists.","argumentHint":"","aliases":["interview-me"]},{"name":"agent-skills:observability-and-instrumentation","description":"(agent-skills) Instruments code so production behavior is visible and diagnosable. Use when adding logging, metrics, tracing, or alerting. Use when shipping any feature that runs in production and you need evidence it works. Use when production issues are reported but you can't tell what happened from the available data.","argumentHint":"","aliases":["observability-and-instrumentation"]},{"name":"agent-skills:performance-optimization","description":"(agent-skills) Optimizes application performance. Use when performance requirements exist, when you suspect performance regressions, or when Core Web Vitals or load times need improvement. Use when profiling reveals bottlenecks that need fixing.","argumentHint":"","aliases":["performance-optimization"]},{"name":"agent-skills:planning-and-task-breakdown","description":"(agent-skills) Breaks work into ordered tasks. Use when you have a spec or clear requirements and need to break work into implementable tasks. Use when a task feels too large to start, when you need to estimate scope, or when parallel work is possible.","argumentHint":"","aliases":["planning-and-task-breakdown"]},{"name":"agent-skills:security-and-hardening","description":"(agent-skills) Hardens code against vulnerabilities. Use when handling user input, authentication, data storage, or external integrations. Use when building any feature that accepts untrusted data, manages user sessions, or interacts with third-party services.","argumentHint":"","aliases":["security-and-hardening"]},{"name":"agent-skills:shipping-and-launch","description":"(agent-skills) Prepares production launches. Use when preparing to deploy to production. Use when you need a pre-launch checklist, when setting up monitoring, when planning a staged rollout, or when you need a rollback strategy.","argumentHint":"","aliases":["shipping-and-launch"]},{"name":"agent-skills:source-driven-development","description":"(agent-skills) Grounds every implementation decision in official documentation. Use when you want authoritative, source-cited code free from outdated patterns. Use when building with any framework or library where correctness matters.","argumentHint":"","aliases":["source-driven-development"]},{"name":"agent-skills:spec-driven-development","description":"(agent-skills) Creates specs before coding. Use when starting a new project, feature, or significant change and no specification exists yet. Use when requirements are unclear, ambiguous, or only exist as a vague idea.","argumentHint":"","aliases":["spec-driven-development"]},{"name":"agent-skills:test-driven-development","description":"(agent-skills) Drives development with tests. Use when implementing any logic, fixing any bug, or changing any behavior. Use when you need to prove that code works, when a bug report arrives, or when you're about to modify existing functionality.","argumentHint":"","aliases":["test-driven-development"]},{"name":"agent-skills:using-agent-skills","description":"(agent-skills) Discovers and invokes agent skills. Use when starting a session or when you need to discover which skill applies to the current task. This is the meta-skill that governs how all other skills are discovered and invoked.","argumentHint":"","aliases":["using-agent-skills"]},{"name":"caveman:caveman","description":"(caveman) Ultra-compressed communication mode. Cuts token usage ~75% by speaking like caveman while keeping full technical accuracy. Supports intensity levels: lite, full (default), ultra. Use when user says \"caveman mode\", \"talk like caveman\", \"use caveman\", \"less tokens\", \"be brief\", or invokes /caveman. Also auto-triggers when token efficiency is requested.","argumentHint":""},{"name":"chrome-devtools-mcp:a11y-debugging","description":"(chrome-devtools-mcp) Uses Chrome DevTools MCP for accessibility (a11y) debugging and auditing based on web.dev guidelines. Use when testing semantic HTML, ARIA labels, focus states, keyboard navigation, tap targets, and color contrast.","argumentHint":"","aliases":["a11y-debugging"]},{"name":"chrome-devtools-mcp:chrome-devtools","description":"(chrome-devtools-mcp) Uses Chrome DevTools via MCP for efficient debugging, troubleshooting and browser automation. Use when debugging web pages, automating browser interactions, analyzing performance, or inspecting network requests. This skill does not apply to `--slim` mode (MCP configuration).","argumentHint":"","aliases":["chrome-devtools"]},{"name":"chrome-devtools-mcp:chrome-devtools-cli","description":"(chrome-devtools-mcp) Use this skill to write shell scripts or run shell commands to automate tasks in the browser or otherwise use Chrome DevTools via CLI.","argumentHint":"","aliases":["chrome-devtools-cli"]},{"name":"chrome-devtools-mcp:cookie-debugging","description":"(chrome-devtools-mcp) Uses Chrome DevTools MCP for inspecting, debugging, and testing cookies, session state, authentication issues, and cookie consent compliance. Use when diagnosing 401/403 errors, authentication redirects, session expiration, Cookie/Set-Cookie header issues, cookie banner consent conformance, or third-party cookie/SameSite/Partitioned cookie warnings.","argumentHint":"","aliases":["cookie-debugging"]},{"name":"chrome-devtools-mcp:debug-optimize-lcp","description":"(chrome-devtools-mcp) Guides debugging and optimizing Largest Contentful Paint (LCP) using Chrome DevTools MCP tools. Use this skill whenever the user asks about LCP performance, slow page loads, Core Web Vitals optimization, or wants to understand why their page's main content takes too long to appear. Also use when the user mentions \"largest contentful paint\", \"page load speed\", \"CWV\", or wants to improve how fast their hero image or main content renders.","argumentHint":"","aliases":["debug-optimize-lcp"]},{"name":"chrome-devtools-mcp:memory-leak-debugging","description":"(chrome-devtools-mcp) Diagnoses and resolves memory leaks in JavaScript/Node.js applications. Use when a user reports high memory usage, OOM errors, or wants to capture, compare, or inspect heap snapshots with Chrome DevTools MCP memory tools.","argumentHint":"","aliases":["memory-leak-debugging"]},{"name":"chrome-devtools-mcp:troubleshooting","description":"(chrome-devtools-mcp) Uses Chrome DevTools MCP and documentation to troubleshoot connection and target issues. Trigger this skill when list_pages, new_page, or navigate_page fail, or when the server initialization fails.","argumentHint":"","aliases":["troubleshooting"]},{"name":"claude-code-setup:claude-automation-recommender","description":"(claude-code-setup) Analyze a codebase and recommend Claude Code automations (hooks, subagents, skills, plugins, MCP servers). Use when user asks for automation recommendations, wants to optimize their Claude Code setup, mentions improving Claude Code workflows, asks how to first set up Claude Code for a project, or wants to know what Claude Code features they should use.","argumentHint":"","aliases":["claude-automation-recommender"]},{"name":"claude-md-management:claude-md-improver","description":"(claude-md-management) Audit and improve CLAUDE.md files in repositories. Use when user asks to check, audit, update, improve, or fix CLAUDE.md files. Scans for all CLAUDE.md files, evaluates quality against templates, outputs quality report, then makes targeted updates. Also use when the user mentions \"CLAUDE.md maintenance\" or \"project memory optimization\".","argumentHint":"","aliases":["claude-md-improver"]},{"name":"everything-claude-code:agent-eval","description":"(everything-claude-code) Head-to-head comparison of coding agents (Claude Code, Aider, Codex, etc.) on custom tasks with pass rate, cost, time, and consistency metrics","argumentHint":"","aliases":["agent-eval"]},{"name":"everything-claude-code:agent-harness-construction","description":"(everything-claude-code) Design and optimize AI agent action spaces, tool definitions, and observation formatting for higher completion rates.","argumentHint":"","aliases":["agent-harness-construction"]},{"name":"everything-claude-code:agentic-engineering","description":"(everything-claude-code) Operate as an agentic engineer using eval-first execution, decomposition, and cost-aware model routing.","argumentHint":"","aliases":["agentic-engineering"]},{"name":"everything-cl