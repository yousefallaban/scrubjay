h === 0) throw new Error(\"A return needs at least one item\");\nsrc/returns.ts:43:      throw new Error(`Cannot return more ${item.productId} than were ordered`);\nsrc/returns.ts:46:  return {\nsrc/returns.ts:47:    id: `return-${nextId++}`,\nsrc/returns.ts:50:    refundCents: calculateRefund(order, items),\nsrc/returns.ts:56:export function approveReturn(ret: Return): Return {\nsrc/returns.ts:57:  if (ret.status !== \"requested\") throw new Error(`A ${ret.status} return cannot be approved`);\nsrc/returns.ts:58:  return { ...ret, status: \"approved\" };\nsrc/returns.ts:61:export function refundReturn(ret: Return): Return {\nsrc/returns.ts:62:  if (ret.status !== \"approved\") throw new Error(\"Only an approved return can be refunded\");\nsrc/returns.ts:63:  return { ...ret, status: \"refunded\" };\nsrc/products.ts:12:  return catalogue.map((p) => ({ ...p }));\nsrc/products.ts:18:  return { ...product };\nsrc/orders.ts:30:    return {\nsrc/orders.ts:36:  return { id: `order-${nextId++}`, customerId: input.customerId, lines, discountPercent, status: \"paid\" };\nsrc/orders.ts:40:  return order.lines.reduce((sum, line) => sum + line.unitPriceCents * line.quantity, 0);\nsrc/orders.ts:46:  return Math.floor((discounted + 50) / 100);\nsrc/orders.ts:50:  return { ...order, status: \"delivered\", deliveredAt: at };\n.gitignore\nAGENTS.md\nCLAUDE.md\nREADME.md\ndocs/architecture/stack.md\ndocs/index.md\npackage.json\nsrc/index.ts\nsrc/orders.ts\nsrc/products.ts\nsrc/returns.ts\ntest/orders.test.ts\ntest/products.test.ts\ntest/returns.test.ts\ntsconfig.json\n","exit_code":0,"status":"completed"}}
