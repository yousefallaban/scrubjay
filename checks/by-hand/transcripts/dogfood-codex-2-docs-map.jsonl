{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"bun --eval 'import { createOrder, markDelivered, orderTotalCents } from \\\"./src/orders\\\";\nimport { submitReturn, approveReturn, refundReturn } from \\\"./src/returns\\\";\nconst at = new Date(\\\"2026-01-01T00:00:00Z\\\");\nconst now = new Date(\\\"2026-01-20T00:00:00Z\\\");\nconst make = (productId, quantity = 1, discountPercent = 0) => markDelivered(createOrder({customerId: \\\"sanne\\\", lines: [{productId, quantity}], discountPercent}), at);\nconst attempt = (operation) => { try { return operation(); } catch (error) { return error.message; } };\nconst socks = make(\\\"wool-socks\\\");\nconst requested = submitReturn(socks, [{productId: \\\"wool-socks\\\", quantity: 1}], now);\nconst approved = approveReturn(requested);\nconst refunded = refundReturn(approved);\nconst discounted = make(\\\"rain-jacket\\\", 1, 45);\nconsole.log(JSON.stringify({\n  empty: attempt(() => submitReturn(socks, [], now)),\n  zeroQuantity: attempt(() => submitReturn(socks, [{productId: \\\"wool-socks\\\", quantity: 0}], now)),\n  fractionalQuantity: attempt(() => submitReturn(socks, [{productId: \\\"wool-socks\\\", quantity: 1.5}], now)),\n  missingDeliveryTime: attempt(() => submitReturn({...socks, deliveredAt: undefined}, [{productId: \\\"wool-socks\\\", quantity: 1}], now)),\n  day30: submitReturn(socks, [{productId: \\\"wool-socks\\\", quantity: 1}], new Date(\\\"2026-01-31T00:00:00Z\\\")).status,\n  day30PlusOneMs: attempt(() => submitReturn(socks, [{productId: \\\"wool-socks\\\", quantity: 1}], new Date(\\\"2026-01-31T00:00:00.001Z\\\"))),\n  combinedRounding: submitReturn(make(\\\"rain-jacket\\\", 2, 15), [{productId: \\\"rain-jacket\\\", quantity: 2}], now).refundCents,\n  fullReturnRounding: {orderCents: orderTotalCents(discounted), refundCents: submitReturn(discounted, [{productId: \\\"rain-jacket\\\", quantity: 1}], now).refundCents},\n  duplicateEntries: submitReturn(socks, 