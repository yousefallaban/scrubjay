d plan in session on 2026-10-13; implementation has not started.\n-- [ ] T2 Add `WishlistProduct` and `getWishlist` in `src/wishlist.ts`; extend `test/wishlist.test.ts` with save/read sequences proving retained saves, one wishlist per customer, duplicate timestamps, isolation, live catalogue details, ordering and empty lists. -> save-item, customer-id-wishlist, preserve-first-save, isolate-wishlists, current-product-details, newest-first, empty-list\n-- [ ] T3 Add `removeWishlistItem` in `src/wishlist.ts`; extend `test/wishlist.test.ts` for successful removal, an unsaved-product error and unchanged wishlists for other customers. -> remove-item, reject-unsaved-product, isolate-removal\n+- [x] T1 Add the private customer-keyed store, `WishlistItem` and `saveWishlistItem` in `src/wishlist.ts`; test product-only save results and unknown-product errors in `test/wishlist.test.ts`. -> product-only-items, reject-unknown-product\n+- [x] T2 Add `WishlistProduct` and `getWishlist` in `src/wishlist.ts`; extend `test/wishlist.test.ts` with save/read sequences proving retained saves, one wishlist per customer, duplicate timestamps, isolation, live catalogue details, ordering and empty lists. -> save-item, customer-id-wishlist, preserve-first-save, isolate-wishlists, current-product-details, newest-first, empty-list\n+- [x] T3 Add `removeWishlistItem` in `src/wishlist.ts`; extend `test/wishlist.test.ts` for successful removal, an unsaved-product error and unchanged wishlists for other customers. -> remove-item, reject-unsaved-product, isolate-removal\n - [ ] T4 Re-export the wishlist functions and types from `src/index.ts`, verify the callable exports in `test/wishlist.test.ts`, and run the complete suite. -> check: all three operations work through src/index.ts and bun test passes\n  +4 -4\n\nsrc/index.ts\n@@ -1,3 +1,4 @@\n export * from \"./products\";\n export * from \"./orders\";\n export * from \"./returns\";\n+export * from \"./wishlist\";\n  +1 -0\nimport { getProduct } from \"./products\";\n\nexport type WishlistItem = { productId: string; savedAt: Date };\nexport type WishlistProduct = WishlistItem & { name: string; priceCents: number };\n\nconst wishlists = new Map<string, Map<string, WishlistItem>>();\n\nexport function saveWishlistItem(\n  customerId: string,\n  productId: string,\n  now: Date = new Date(),\n): WishlistItem {\n  getProduct(productId);\n\n  let wishlist = wishlists.get(customerId);\n  if (!wishlist) {\n    wishlist = new Map<string, WishlistItem>();\n    wishlists.set(customerId, wishlist);\n  }\n\n  let item = wishlist.get(productId);\n  if (!item) {\n    item = { productId, savedAt: new Date(now.getTime()) };\n    wishlist.set(productId, item);\n  }\n\n  return { ...item, savedAt: new Date(item.savedAt.getTime()) };\n}\n\nexport function getWishlist(customerId: string): WishlistProduct[] {\n  const wishlist = wishlists.get(customerId);\n  if (!wishlist) return [];\n\n  return [...wishlist.values()]\n    .sort((a, b) => b.savedAt.getTime() - a.savedAt.getTime())\n    .map((item) => {\n      const product = getProduct(item.productId);\n      return {\n        productId: item.productId,\n        name: product.name,\n        priceCents: product.priceCents,\n        savedAt: new Date(item.savedAt.getTime()),\n      };\n    });\n}\n\nexport function removeWishlistItem(customerId: string, productId: string): void {\n  const wishlist = wishlists.get(customerId);\n  if (!wishlist?.delete(productId)) {\n    throw new Error(`Product ${productId} is not on the wishlist for ${customerId}`);\n  }\n  if (wishlist.size === 0) wishlists.delete(customerId);\n}\nimport { describe, expect, spyOn, test } from \"bun:test\";\nimport * as webshop from \"../src/index\";\nimport * as products from \"../src/products\";\nimport { getWishlist, removeWishlistItem, saveWishlistItem } from \"../src/wishlist\";\n\ndescribe(\"wishlist\", () => {\n  test(\"saves only a product ID and save time [wishlist/save-items#product-only-items]\", () => {\n    const savedAt = new Date(\"2026-10-13T10:00:00Z\");\n\n    expect(saveWishlistItem(\"product-only\", \"headlamp\", savedAt)).toEqual({\n      productId: \"headlamp\",\n      savedAt,\n    });\n  });\n\n  test(\"defaults the save moment to the current time [wishlist/save-items#product-only-items]\", () => {\n    const before = Date.now();\n    const item = saveWishlistItem(\"default-time\", \"wool-socks\");\n\n    expect(item.productId).toBe(\"wool-socks\");\n    expect(item.savedAt.getTime()).toBeGreaterThanOrEqual(before);\n    expect(item.savedAt.getTime()).toBeLessThanOrEqual(Date.now());\n  });\n\n  test(\"rejects a product absent from the catalogue [wishlist/save-items#reject-unknown-product]\", () => {\n    expect(() => saveWishlistItem(\"unknown-product\", \"unicorn\")).toThrow(Error);\n    expect(getWishlist(\"unknown-product\")).toEqual([]);\n  });\n\n  test(\"retains saves for every catalogue product [wishlist/save-items#save-item]\", () => {\n    const savedAt = new Date(\"2026-10-13T10:00:00Z\");\n\n    for (const product of products.listProducts()) {\n      const customerId = `save-${product.id}`;\n      saveWishlistItem(customerId, product.id, savedAt);\n\n      expect(getWishlist(customerId)).toEqual([\n        { productId: product.id, name: product.name, priceCents: product.priceCents, savedAt },\n      ]);\n    }\n  });\n\n  test(\"uses one wishlist for each supplied customer ID [wishlist/save-items#customer-id-wishlist]\", () => {\n    saveWishlistItem(\"no-customer-record\", \"headlamp\", new Date(\"2026-10-13T10:00:00Z\"));\n    saveWishlistItem(\"no-customer-record\", \"trail-map\", new Date(\"2026-10-13T10:05:00Z\"));\n\n    expect(getWishlist(\"no-customer-record\").map((item) => item.productId)).toEqual([\n      \"trail-map\",\n      \"headlamp\",\n    ]);\n  });\n\n  test(\"preserves the first save and position on a duplicate [wishlist/save-items#preserve-first-save]\", () => {\n    const firstSave = new Date(\"2026-10-13T10:00:00Z\");\n    const secondSave = new Date(\"2026-10-13T10:05:00Z\");\n    saveWishlistItem(\"duplicate\", \"headlamp\", firstSave);\n    saveWishlistItem(\"duplicate\", \"trail-map\", secondSave);\n\n    expect(saveWishlistItem(\"duplicate\", \"headlamp\", new Date(\"2026-10-13T10:10:00Z\"))).toEqual({\n      productId: \"headlamp\",\n      savedAt: firstSave,\n    });\n    expect(getWishlist(\"duplicate\").map(({ productId, savedAt }) => ({ productId, savedAt }))).toEqual([\n      { productId: \"trail-map\", savedAt: secondSave },\n      { productId: \"headlamp\", savedAt: firstSave },\n    ]);\n  });\n\n  test(\"protects the first save from caller mutations [wishlist/save-items#preserve-first-save]\", () => {\n    const originalTime = new Date(\"2026-10-13T10:00:00Z\");\n    const inputTime = new Date(originalTime.getTime());\n    const saved = saveWishlistItem(\"copies\", \"headlamp\", inputTime);\n    inputTime.setTime(0);\n    saved.savedAt.setTime(1);\n    saved.productId = \"trail-map\";\n\n    const repeated = saveWishlistItem(\"copies\", \"headlamp\", new Date(\"2026-10-13T11:00:00Z\"));\n    expect(repeated).toEqual({ productId: \"headlamp\", savedAt: originalTime });\n    repeated.savedAt.setTime(2);\n    repeated.productId = \"wool-socks\";\n\n    const viewed = getWishlist(\"copies\");\n    expect(viewed).toEqual([\n      { productId: \"headlamp\", name: \"Headlamp\", priceCents: 3499, savedAt: originalTime },\n    ]);\n    viewed[0].savedAt.setTime(3);\n    viewed[0].productId = \"water-bottle\";\n    viewed[0].name = \"Changed\";\n    viewed[0].priceCents = 0;\n    viewed.pop();\n\n    expect(getWishlist(\"copies\")).toEqual([\n      { productId: \"headlamp\", name: \"Headlamp\", priceCents: 3499, savedAt: originalTime },\n    ]);\n  });\n\n  test(\"reads only the addressed customer's products [wishlist/view-items#isolate-wishlists]\", () => {\n    saveWishlistItem(\"reader-one\", \"headlamp\");\n    saveWishlistItem(\"reader-two\", \"trail-map\");\n\n    expect(getWishlist(\"reader-one\").map((item) => item.productId)).toEqual([\"headlamp\"]);\n    expect(getWishlist(\"reader-two\").map((item) => item.productId)).toEqual([\"trail-map\"]);\n  });\n\n  test(\"uses customer IDs as supplied [wishlist/save-items#customer-id-wishlist]\", () => {\n    saveWishlistItem(\"Exact-ID\", \"headlamp\");\n    saveWishlistItem(\"exact-id\", \"trail-map\");\n    saveWishlistItem(\" Exact-ID \", \"wool-socks\");\n    saveWishlistItem(\"\", \"water-bottle\");\n\n    expect(getWishlist(\"Exact-ID\").map((item) => item.productId)).toEqual([\"headlamp\"]);\n    expect(getWishlist(\"exact-id\").map((item) => item.productId)).toEqual([\"trail-map\"]);\n    expect(getWishlist(\" Exact-ID \").map((item) => item.productId)).toEqual([\"wool-socks\"]);\n    expect(getWishlist(\"\").map((item) => item.productId)).toEqual([\"water-bottle\"]);\n  });\n\n  test(\"resolves current catalogue details on every read [wishlist/view-items#current-product-details]\", () => {\n    const getProduct = products.getProduct;\n    const currentProduct = { ...getProduct(\"headlamp\"), priceCents: 3000 };\n    const lookup = spyOn(products, \"getProduct\").mockImplementation((id) =>\n      id === currentProduct.id ? { ...currentProduct } : getProduct(id),\n    );\n\n    try {\n      const savedAt = new Date(\"2026-10-13T10:00:00Z\");\n      saveWishlistItem(\"current-details\", \"headlamp\", savedAt);\n      currentProduct.name = \"Updated headlamp\";\n      currentProduct.priceCents = 3500;\n\n      expect(getWishlist(\"current-details\")).toEqual([\n        { productId: \"headlamp\", name: \"Updated headlamp\", priceCents: 3500, savedAt },\n      ]);\n\n      currentProduct.priceCents = 3600;\n      expect(getWishlist(\"current-details\")[0].priceCents).toBe(3600);\n    } finally {\n      lookup.mockRestore();\n    }\n  });\n\n  test(\"orders by save time rather than call order [wishlist/view-items#newest-first]\", () => {\n    saveWishlistItem(\"ordered\", \"headlamp\", new Date(\"2026-10-13T10:00:00Z\"));\n    saveWishlistItem(\"ordered\", \"trail-map\", new Date(\"2026-10-13T10:10:00Z\"));\n    saveWishlistItem(\"ordered\", \"wool-socks\", new Date(\"2026-10-13T10:05:00Z\"));\n\n    expect(getWishlist(\"ordered\").map((item) => item.productId)).toEqual([\n      \"trail-map\",\n      \"wool-socks\",\n      \"headlamp\",\n    ]);\n  });\n\n  test(\"keeps insertion order for equal save times [wishlist/view-items#newest-first]\", () => {\n    const savedAt = new Date(\"2026-10-13T10:00:00Z\");\n    saveWishlistItem(\"tied-times\", \"headlamp\", savedAt);\n    saveWishlistItem(\"tied-times\", \"trail-map\", savedAt);\n    saveWishlistItem(\"tied-times\", \"headlamp\", savedAt);\n\n    expect(getWishlist(\"tied-times\").map((item) => item.productId)).toEqual([\"headlamp\", \"trail-map\"]);\n  });\n\n  test(\"returns an empty list for a customer with no saves [wishlist/view-items#empty-list]\", () => {\n    expect(getWishlist(\"never-saved\")).toEqual([]);\n  });\n\n  test(\"removes the addressed product and leaves other saves [wishlist/remove-items#remove-item]\", () => {\n    saveWishlistItem(\"removal\", \"headlamp\");\n    saveWishlistItem(\"removal\", \"trail-map\");\n    const remaining = getWishlist(\"removal\").filter((item) => item.productId === \"trail-map\");\n\n    expect(removeWishlistItem(\"removal\", \"headlamp\")).toBeUndefined();\n    expect(getWishlist(\"removal\")).toEqual(remaining);\n\n    removeWishlistItem(\"removal\", \"trail-map\");\n    expect(getWishlist(\"removal\")).toEqual([]);\n  });\n\n  test(\"allows a removed product to be saved anew [wishlist/remove-items#remove-item]\", () => {\n    saveWishlistItem(\"save-again\", \"headlamp\", new Date(\"2026-10-13T10:00:00Z\"));\n    removeWishlistItem(\"save-again\", \"headlamp\");\n    const savedAt = new Date(\"2026-10-13T11:00:00Z\");\n\n    expect(saveWishlistItem(\"save-again\", \"headlamp\", savedAt)).toEqual({ productId: \"headlamp\", savedAt });\n    expect(getWishlist(\"save-again\")).toEqual([\n      { productId: \"headlamp\", name: \"Headlamp\", priceCents: 3499, savedAt },\n    ]);\n  });\n\n  test(\"rejects removal of an unsaved product without changing the list [wishlist/remove-items#reject-unsaved-product]\", () => {\n    saveWishlistItem(\"unsaved-removal\", \"trail-map\");\n    const before = getWishlist(\"unsaved-removal\");\n\n    expect(() => removeWishlistItem(\"unsaved-removal\", \"headlamp\")).toThrow(Error);\n    expect(() => removeWishlistItem(\"unsaved-removal\", \"unicorn\")).toThrow(Error);\n    expect(getWishlist(\"unsaved-removal\")).toEqual(before);\n  });\n\n  test(\"rejects removal from an absent or emptied wishlist [wishlist/remove-items#reject-unsaved-product]\", () => {\n    expect(() => removeWishlistItem(\"empty-removal\", \"headlamp\")).toThrow(Error);\n    expect(getWishlist(\"empty-removal\")).toEqual([]);\n\n    saveWishlistItem(\"empty-removal\", \"headlamp\");\n    removeWishlistItem(\"empty-removal\", \"headlamp\");\n\n    expect(() => removeWishlistItem(\"empty-removal\", \"headlamp\")).toThrow(Error);\n    expect(getWishlist(\"empty-removal\")).toEqual([]);\n  });\n\n  test(\"leaves other customers unchanged after successful or failed removal [wishlist/remove-items#isolate-removal]\", () => {\n    saveWishlistItem(\"removal-one\", \"headlamp\");\n    saveWishlistItem(\"removal-two\", \"headlamp\");\n    saveWishlistItem(\"removal-two\", \"trail-map\");\n    const otherWishlist = getWishlist(\"removal-two\");\n\n    expect(() => removeWishlistItem(\"removal-one\", \"trail-map\")).toThrow(Error);\n    expect(getWishlist(\"removal-two\")).toEqual(otherWishlist);\n\n    removeWishlistItem(\"removal-one\", \"headlamp\");\n    expect(getWishlist(\"removal-one\")).toEqual([]);\n    expect(getWishlist(\"removal-two\")).toEqual(otherWishlist);\n\n    expect(() => removeWishlistItem(\"removal-one\", \"headlamp\")).toThrow(Error);\n    expect(getWishlist(\"removal-two\")).toEqual(otherWishlist);\n  });\n\n  test(\"supports a full wishlist flow through the public entry point [wishlist/save-items#save-item]\", () => {\n    const savedAt = new Date(\"2026-10-13T10:00:00Z\");\n    const saved: webshop.WishlistItem = webshop.saveWishlistItem(\"public-exports\", \"headlamp\", savedAt);\n    expect(saved).toEqual({ productId: \"headlamp\", savedAt });\n\n    const wishlist: webshop.WishlistProduct[] = webshop.getWishlist(\"public-exports\");\n    expect(wishlist).toEqual([\n      { productId: \"headlamp\", name: \"Headlamp\", priceCents: 3499, savedAt },\n    ]);\n\n    expect(webshop.removeWishlistItem(\"public-exports\", \"headlamp\")).toBeUndefined();\n    expect(webshop.getWishlist(\"public-exports\")).toEqual([]);\n  });\n});\n","exit_code":0,"status":"completed"}}
