{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/returns.ts'","aggregated_output":"     1\timport type { Order } from \"./orders\";\n     2\t\n     3\texport type ReturnItem = { productId: string; quantity: number };\n     4\texport type ReturnStatus = \"requested\" | \"approved\" | \"refunded\";\n     5\texport type Return = {\n     6\t  id: string;\n     7\t  orderId: string;\n     8\t  items: ReturnItem[];\n     9\t  refundCents: number;\n    10\t  status: ReturnStatus;\n    11\t  requestedAt: Date;\n    12\t};\n    13\t\n    14\texport const RETURN_WINDOW_DAYS = 30;\n    15\tconst DAY_MS = 86_400_000;\n    16\tlet nextId = 1;\n    17\t\n    18\texport function calculateRefund(order: Order, items: ReturnItem[]): number {\n    19\t  const subtotal = items.reduce((sum, item) => {\n    20\t    const line = order.lines.find((l) => l.productId === item.productId);\n    21\t    if (!line) throw new Error(`Product ${item.productId} is not on order ${order.id}`);\n    22\t    return sum + line.unitPriceCents * item.quantity;\n    23\t  }, 0);\n    24\t  return Math.round(subtotal * (1 - order.discountPercent / 100));\n    25\t}\n    26\t\n    27\texport function submitReturn(order: Order, items: ReturnItem[], now: Date = new Date()): Return {\n    28\t  if (order.status !== \"delivered\" || !order.deliveredAt) {\n    29\t    throw new Error(\"Only delivered orders can be returned\");\n    30\t  }\n    31\t  const ageDays = (now.getTime() - order.deliveredAt.getTime()) / DAY_MS;\n    32\t  if (ageDays > RETURN_WINDOW_DAYS) {\n    33\t    throw new Error(`Returns are accepted within ${RETURN_WINDOW_DAYS} days of delivery`);\n    34\t  }\n    35\t  if (items.length === 0) throw new Error(\"A return needs at least one item\");\n    36\t  for (const item of items) {\n    37\t    const line = order.lines.find((l) => l.productId === item.productId);\n    38\t    if (!line) throw new Error(`Product ${item.productId} is not on order ${order.id}`);\n    39\t    if (!Number.isInteger(item.quantity) || item.quantity < 1) {\n    40\t      throw new Error(\"Quantity must be a whole number of at least 1\");\n    41\t    }\n    42\t    if (item.quantity > line.quantity) {\n    43\t      throw new Error(`Cannot return more ${item.productId} than were ordered`);\n    44\t    }\n    45\t  }\n    46\t  return {\n    47\t    id: `return-${nextId++}`,\n    48\t    orderId: order.id,\n    49\t    items: items.map((i) => ({ ...i })),\n    50\t    refundCents: calculateRefund(order, items),\n    51\t    status: \"requested\",\n    52\t    requestedAt: now,\n    53\t  };\n    54\t}\n    55\t\n    56\texport function approveReturn(ret: Return): Return {\n    57\t  if (ret.status !== \"requested\") throw new Error(`A ${ret.status} return cannot be approved`);\n    58\t  return { ...ret, status: \"approved\" };\n    59\t}\n    60\t\n    61\texport function refundReturn(ret: Return): Return {\n    62\t  if (ret.status !== \"approved\") throw new Error(\"Only an approved return can be refunded\");\n    63\t  return { ...ret, status: \"refunded\" };\n    64\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'nl -ba test/returns.test.ts'","aggregated_output":"     1\timport { describe, expect, test } from \"bun:test\";\n     2\timport { createOrder, markDelivered } from \"../src/orders\";\n     3\timport { approveReturn, refundReturn, submitReturn } from \"../src/returns\";\n     4\t\n     5\tconst deliveredAt = new Date(\"2026-01-01\");\n     6\tconst inWindow = new Date(\"2026-01-20\");\n     7\t\n     8\tfunction deliveredOrder(lines: { productId: string; quantity: number }[], discountPercent = 0) {\n     9\t  return markDelivered(createOrder({ customerId: \"sanne\", lines, discountPercent }), deliveredAt);\n    10\t}\n    11\t\n    12\tdescribe(\"returns\", () => {\n    13\t  test(\"refunds only the returned items of an order\", () => {\n    14\t    const order = deliveredOrder([\n    15\t      { productId: \"rain-jacket\", quantity: 2 },\n    16\t      { productId: \"trail-map\", quantity: 1 },\n    17\t    ]);\n    18\t    const ret = submitReturn(order, [{ productId: \"rain-jacket\", quantity: 1 }], inWindow);\n    19\t    expect(ret.refundCents).toBe(1990);\n    20\t    expect(ret.status).toBe(\"requested\");\n    21\t  });\n    22\t\n    23\t  test(\"applies the order discount to the refund\", () => {\n    24\t    const order = deliveredOrder([{ productId: \"water-bottle\", quantity: 1 }], 10);\n    25\t    const ret = submitReturn(order, [{ productId: \"water-bottle\", quantity: 1 }], inWindow);\n    26\t    expect(ret.refundCents).toBe(1800);\n    27\t  });\n    28\t\n    29\t  test(\"rejects more items than were ordered\", () => {\n    30\t    const order = deliveredOrder([{ productId: \"wool-socks\", quantity: 1 }]);\n    31\t    expect(() => submitReturn(order, [{ productId: \"wool-socks\", quantity: 2 }], inWindow)).toThrow(\n    32\t      \"more wool-socks than were ordered\",\n    33\t    );\n    34\t  });\n    35\t\n    36\t  test(\"rejects a product that is not on the order\", () => {\n    37\t    const order = deliveredOrder([{ productId: \"wool-socks\", quantity: 1 }]);\n    38\t    expect(() => submitReturn(order, [{ productId: \"headlamp\", quantity: 1 }], inWindow)).toThrow(\"not on order\");\n    39\t  });\n    40\t\n    41\t  test(\"rejects an order that has not been delivered\", () => {\n    42\t    const order = createOrder({ customerId: \"sanne\", lines: [{ productId: \"wool-socks\", quantity: 1 }] });\n    43\t    expect(() => submitReturn(order, [{ productId: \"wool-socks\", quantity: 1 }], inWindow)).toThrow(\n    44\t      \"Only delivered orders\",\n    45\t    );\n    46\t  });\n    47\t\n    48\t  test(\"accepts a return on day 30 and rejects it after\", () => {\n    49\t    const order = deliveredOrder([{ productId: \"wool-socks\", quantity: 1 }]);\n    50\t    expect(submitReturn(order, [{ productId: \"wool-socks\", quantity: 1 }], new Date(\"2026-01-31\")).status).toBe(\n    51\t      \"requested\",\n    52\t    );\n    53\t    expect(() => submitReturn(order, [{ productId: \"wool-socks\", quantity: 1 }], new Date(\"2026-02-05\"))).toThrow(\n    54\t      \"within 30 days\",\n    55\t    );\n    56\t  });\n    57\t\n    58\t  test(\"moves from requested to approved to refunded, in that order\", () => {\n    59\t    const order = deliveredOrder([{ productId: \"wool-socks\", quantity: 1 }]);\n    60\t    const requested = submitReturn(order, [{ productId: \"wool-socks\", quantity: 1 }], inWindow);\n    61\t    expect(() => refundReturn(requested)).toThrow(\"Only an approved return\");\n    62\t    const approved = approveReturn(requested);\n    63\t    expect(approved.status).toBe(\"approved\");\n    64\t    expect(() => approveReturn(approved)).toThrow(\"cannot be approved\");\n    65\t    expect(refundReturn(approved).status).toBe(\"refunded\");\n    66\t  });\n    67\t});\n","exit_code":0,"status":"completed"}}
