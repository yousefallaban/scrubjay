{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/orders.ts'","aggregated_output":"     1\timport { getProduct } from \"./products\";\n     2\t\n     3\texport type OrderLine = { productId: string; quantity: number; unitPriceCents: number };\n     4\texport type OrderStatus = \"paid\" | \"delivered\";\n     5\texport type Order = {\n     6\t  id: string;\n     7\t  customerId: string;\n     8\t  lines: OrderLine[];\n     9\t  discountPercent: number;\n    10\t  status: OrderStatus;\n    11\t  deliveredAt?: Date;\n    12\t};\n    13\t\n    14\tlet nextId = 1;\n    15\t\n    16\texport function createOrder(input: {\n    17\t  customerId: string;\n    18\t  lines: { productId: string; quantity: number }[];\n    19\t  discountPercent?: number;\n    20\t}): Order {\n    21\t  if (input.lines.length === 0) throw new Error(\"An order needs at least one line\");\n    22\t  const discountPercent = input.discountPercent ?? 0;\n    23\t  if (discountPercent < 0 || discountPercent > 100) {\n    24\t    throw new Error(\"Discount must be between 0 and 100 percent\");\n    25\t  }\n    26\t  const lines = input.lines.map((line) => {\n    27\t    if (!Number.isInteger(line.quantity) || line.quantity < 1) {\n    28\t      throw new Error(\"Quantity must be a whole number of at least 1\");\n    29\t    }\n    30\t    return {\n    31\t      productId: line.productId,\n    32\t      quantity: line.quantity,\n    33\t      unitPriceCents: getProduct(line.productId).priceCents,\n    34\t    };\n    35\t  });\n    36\t  return { id: `order-${nextId++}`, customerId: input.customerId, lines, discountPercent, status: \"paid\" };\n    37\t}\n    38\t\n    39\texport function subtotalCents(order: Order): number {\n    40\t  return order.lines.reduce((sum, line) => sum + line.unitPriceCents * line.quantity, 0);\n    41\t}\n    42\t\n    43\texport function orderTotalCents(order: Order): number {\n    44\t  // Discount on the subtotal, rounded half up to the cent, in integer arithmetic.\n    45\t  const discounted = subtotalCents(order) * (100 - order.discountPercent);\n    46\t  return Math.floor((discounted + 50) / 100);\n    47\t}\n    48\t\n    49\texport function markDelivered(order: Order, at: Date = new Date()): Order {\n    50\t  return { ...order, status: \"delivered\", deliveredAt: at };\n    51\t}\n","exit_code":0,"status":"completed"}}
